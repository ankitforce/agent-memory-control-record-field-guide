{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Control Record",
  "type": "object",
  "required": ["record_id", "scope", "data_class", "retention", "access", "evidence"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["tenant_id", "workflow"],
      "properties": {"tenant_id": {"type": "string"}, "workflow": {"type": "string"}}
    },
    "data_class": {"type": "string", "minLength": 1},
    "retention": {
      "type": "object",
      "required": ["expires_at", "policy_version"],
      "properties": {"expires_at": {"type": "string", "format": "date-time"}, "policy_version": {"type": "string"}}
    },
    "access": {
      "type": "object",
      "required": ["readers", "change_authority"],
      "properties": {"readers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "change_authority": {"type": "string"}}
    },
    "evidence": {
      "type": "object",
      "required": ["write_receipt"],
      "properties": {"write_receipt": {"type": "string"}, "expiry_enforced_at": {"type": ["string", "null"], "format": "date-time"}}
    }
  },
  "additionalProperties": false
}
